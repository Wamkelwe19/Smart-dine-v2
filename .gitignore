# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit these.
# Build-time config consumed via --dart-define-from-file=env.json
env.json
env.*.json
.env
.env.*
# The templates carry no secrets and SHOULD be committed, so teammates know
# which keys to supply.
!env.example.json
!.env.example
# Google OAuth client config
**/google-services.json
**/GoogleService-Info.plist
# Release signing
key.properties
**/*.keystore
**/*.jks
# Supabase CLI local state (migrations themselves ARE committed)
supabase/.temp/
supabase/.branches/
